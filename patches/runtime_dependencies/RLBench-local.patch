+    
+    def get_random_eef_start(self):
+        """
+        Randomly set the end-effector position to a random point within the task's bounding box.
+        """
+        dummy = Dummy.create(0.03)
+        minx = self._scene._workspace_minx
+        maxx = self._scene._workspace_maxx
+        miny = self._scene._workspace_miny
+        maxy = self._scene._workspace_maxy
+        minz = self._scene._workspace_minz
+        maxz = self._scene._workspace_maxz
+
+        eef_new_position = np.array([np.random.uniform(minx, maxx),
+                                    np.random.uniform(miny, maxy),
+                                    np.random.uniform(minz, maxz)])
+        eef_z_rotation = np.random.uniform(-0.7, 0.7)
+        eef_y_rotation = np.pi
+        eef_z_rotation_quat = np.array([0.0, 0.0, np.sin(eef_z_rotation / 2), np.cos(eef_z_rotation / 2)])
+        eef_y_rotation_quat = np.array([0.0, np.sin(eef_y_rotation / 2), 0.0, np.cos(eef_y_rotation / 2)])
+
+        dummy.set_position(eef_new_position)
+        dummy.set_quaternion(eef_y_rotation_quat)
+        dummy.set_quaternion(eef_z_rotation_quat, relative_to=dummy)
+    
+        # Create quaternion for rotation around z-axis
+        gripper_state = 1
+        action = np.concatenate((dummy.get_position(), dummy.get_quaternion(), [gripper_state]))
+    
+        # Change arm action mode to planning when reaching initial pose
+        current_action_mode = self._action_mode
+        self._action_mode = MoveArmThenGripper(
+            arm_action_mode=EndEffectorPoseViaPlanning(),
+            gripper_action_mode=Discrete()
+        )
+        self._action_mode = current_action_mode
+        try:
+            self.step(action)
+        except Exception as e:
+            dummy.remove()
+    
+        dummy.remove()
