@@ -0,0 +1,464 @@
+import os
+import time
+import cv2
+import pdb
+import argparse
+import pickle
+import open3d as o3d
+import numpy as np
+from scipy.spatial.transform import Rotation as Rot
+import json
+from tqdm import tqdm
+from rlbench.action_modes.action_mode import MoveArmThenGripper
+from rlbench.action_modes.arm_action_modes import JointVelocity, EndEffectorPoseViaIK, EndEffectorPoseViaPlanning
+from rlbench.action_modes.gripper_action_modes import Discrete
+from rlbench.environment import Environment, TaskEnvironment
+from rlbench.observation_config import CameraConfig, ObservationConfig
+from rlbench.tasks import PhoneOnBase
+from tqdm import trange
+from rlbench.tasks import *
+from rlb_cameras import RLBCameras
+from pcd_scaler import scale_icp
+from utils import visualise_pcds
+import matplotlib.pyplot as plt
+from utils import pose_7dof_to_6dof, transform_to_7d_pose, pose_6dof_to_transform, pose_7dof_to_transform, transform_pcd
+from rlb_point_cloud import preprocess_point_cloud
+try:
+    import gym
+    from gym import spaces
+except ModuleNotFoundError:
+    import gymnasium as gym
+    from gymnasium import spaces
+
+
+TASK_NAMES = {
+    'lift_lid': TakeLidOffSaucepan,
+    'phone_on_base': PhoneOnBase,
+    'open_box': OpenBox,
+    'slide_block': SlideBlockToTarget,
+    'close_box': CloseBox,
+    'basketball': BasketballInHoop,
+    'buzz': BeatTheBuzz,
+    'close_microwave': CloseMicrowave,
+    'plate_out': TakePlateOffColoredDishRack,
+    'toilet_seat_down': ToiletSeatDown,
+    'toilet_seat_up': ToiletSeatUp,
+    'toilet_roll_off': TakeToiletRollOffStand,
+    'open_microwave': OpenMicrowave,
+    'lamp_on': LampOn,
+    'umbrella_out': TakeUmbrellaOutOfUmbrellaStand,
+    'push_button': PushButton,
+    'put_rubbish': PutRubbishInBin,
+    'close_jar': CloseJar,
+    'open_jar': OpenJar,
+    'meat_off_grill': MeatOffGrill
+}
+
+
+class RLBenchEnv(gym.Env):
+    def __init__(self, 
+                 task_name="phone_on_base",
+                 depth_estimator=None,
+                 camera_names=['front', 'left_shoulder'], 
+                 resolution=128, 
+                 num_points=1024,
+                 headless=False,
+                 debug=False,
+                 record_point_cloud_reference=False,
+                 gt_noise_std_m=0.010,
+                 gt_noise_seed=0):
+        obs_config = ObservationConfig()
+        obs_config.set_all_low_dim(True)
+        obs_config.set_all_high_dim(False)
+
+        self.depth_estimator = depth_estimator
+        self.resolution = resolution
+        self.camera_names = camera_names
+        self.mask_input = False
+        self.num_points = num_points
+        self.debug = debug
+        self.record_point_cloud_reference = record_point_cloud_reference
+        self.gt_noise_std_m = float(gt_noise_std_m)
+        self.gt_noise_seed = int(gt_noise_seed)
+        self._render_frame = None
+        self._latest_gt_point_cloud_world = None
+        self._last_point_cloud_timing = None
+        self._timing_records = []
+        self.metric_reference_point_cloud = None
