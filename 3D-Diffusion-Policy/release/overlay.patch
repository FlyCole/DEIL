+        if not self.agent_positions:
+            raise RuntimeError("No rollout data recorded. Call reset() first.")
+
+        frame_count = len(self.frames)
+        if len(self.agent_positions) != frame_count \
+                or len(self.observation_point_clouds) != frame_count:
+            raise RuntimeError(
+                "RGB/data frame-count mismatch: "
+                f"rgb={frame_count}, agent_pos={len(self.agent_positions)}, "
+                f"point_cloud={len(self.observation_point_clouds)}"
+            )
+
+        payload = {
+            'agent_pos': np.stack(self.agent_positions).astype(np.float32),
+            'obs_pointcloud': np.stack(self.observation_point_clouds).astype(np.float32),
+            'fps': np.asarray(float(fps), dtype=np.float32),
