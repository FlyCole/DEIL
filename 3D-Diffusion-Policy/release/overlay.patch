+        'observation_count': int(sum(
+            int(record.get('observation_count', 0))
+            for record in step_records
+        )),
+        'stage_descriptions': STAGE_DESCRIPTIONS,
+        'step_weighted_statistics': step_weighted,
+        'rollout_weighted_statistics': rollout_weighted,
+        'evaluation_average_ms': {
+            stage.removesuffix('_ms'): rollout_weighted[stage]['mean_ms']
+            for stage in STAGE_FIELDS
+        },
+        'policy_step_definition': (
+            'One row is one policy decision. Observation-stage times are the '
+            'sum of all observations produced since the previous decision; '
+            'observation_count records how many were combined.'
+        ),
+        'aggregation_note': (
+            'Step-weighted statistics treat every policy step equally. '
+            'Rollout-weighted statistics first average steps within each '
+            'rollout, then average rollout means equally. '
+            'evaluation_average_ms is the rollout-weighted mean.'
+        ),
+        'files': {
+            'step_timings_csv': str(step_path),
+            'rollout_timing_summary_csv': str(rollout_path),
+            'evaluation_timing_summary_json': str(summary_path),
+        },
+    }
+    _atomic_json(summary_path, payload)
+    return payload
+
+class RLBenchRunner(BaseRunner):
+    def __init__(self,
+                 output_dir,
+                 eval_episodes=20,
+                 max_steps=1000,
+                 n_obs_steps=8,
+                 n_action_steps=8,
+                 fps=10,
+                 crf=22,
+                 render_size=84,
+                 tqdm_interval_sec=5.0,
+                 n_envs=None,
+                 task_name=None,
+                 n_train=None,
+                 n_test=None,
+                 device="cuda:0",
+                 use_point_crop=True,
+                 num_points=1024,
+                 depth_est_name=None,
+                 camera_names=['front', 'left_shoulder'],
+                 resolution=128,
+                 headless=False,
+                 debug=False,
+                 save_rollout_video=True,
+                 save_rollout_data=True,
+                 rollout_dir='rollouts',
+                 gt_noise_std_m=0.010,
+                 gt_noise_seed=0,
+                 d435_baseline_m=0.05,
+                 d435_disparity_noise_std_px=0.05,
+                 d435_disparity_bias_px=0.02,
+                 d435_disparity_quantization_px=1.0 / 32.0,
+                 d435_noise_seed=0,
+                 save_timing=False,
+                 timing_dir='timing',
+                 ):
+        super().__init__(output_dir)
+        self.task_name = task_name
+        self.camera_names = camera_names
+        self.resolution = resolution
+        self.save_rollout_video = save_rollout_video
+        self.save_rollout_data = save_rollout_data
+        self.rollout_dir = rollout_dir
+        self.save_timing = bool(save_timing)
+        self.timing_dir = str(timing_dir)
+        self.depth_est_name = str(depth_est_name)
+
+        normalized_depth_est_name = str(depth_est_name).casefold()
+        if normalized_depth_est_name == 'gt':
+            self.depth_estimator = None
+        elif normalized_depth_est_name.startswith(('gt_noisy', 'gt-noisy')):
+            from depth_estimators.gt_noisy import GTNoisyDepth
+            self.depth_estimator = GTNoisyDepth(
+                name=depth_est_name,
+                default_std_m=gt_noise_std_m,
+                seed=gt_noise_seed,
+            )
+        elif normalized_depth_est_name.startswith(('gt_d435', 'gt-d435')):
+            from depth_estimators.gt_d435 import GTD435Depth
+            self.depth_estimator = GTD435Depth(
+                name=depth_est_name,
+                baseline_m=d435_baseline_m,
+                disparity_noise_std_px=d435_disparity_noise_std_px,
+                disparity_bias_px=d435_disparity_bias_px,
+                disparity_quantization_px=d435_disparity_quantization_px,
+                seed=d435_noise_seed,
+            )
+        elif normalized_depth_est_name == 'vggt':
+            from depth_estimators.vggt_est import VGGT
+            self.depth_estimator = VGGT()
+        elif normalized_depth_est_name == 'map_anything':
+            from depth_estimators.map_anything_est import MapAnythingEst
+            self.depth_estimator = MapAnythingEst()
+        elif normalized_depth_est_name == 'mast3r':
+            from depth_estimators.mast3r_est import Mast3rEst
+            self.depth_estimator = Mast3rEst()
+        elif normalized_depth_est_name == 'moge':
+            from depth_estimators.moge_depth import MoGeDepth
+            self.depth_estimator = MoGeDepth()
+        elif normalized_depth_est_name == 'pi3':
+            from depth_estimators.pi3_est import Pi3Est
+            self.depth_estimator = Pi3Est()
+        else:
+            raise ValueError(f'Unknown depth estimator: {depth_est_name!r}')
+
+        self.eval_episodes = eval_episodes
+        def env_fn(task_name):
+            return MultiStepWrapper(
+                SimpleVideoRecordingWrapper(
+                    RLBenchEnv(
+                        task_name=task_name,
+                        num_points=num_points,
+                        depth_estimator=self.depth_estimator,
+                        camera_names=self.camera_names,
+                        resolution=self.resolution,
+                        headless=headless,
+                        debug=debug,
+                        record_point_cloud_reference=save_rollout_data,
+                        gt_noise_std_m=gt_noise_std_m,
+                        gt_noise_seed=gt_noise_seed,
+                    ),
+                    record_rollout_data=save_rollout_data,
+                ),
+                n_obs_steps=n_obs_steps,
+                n_action_steps=n_action_steps,
+                max_episode_steps=max_steps,
+                reward_agg_method='sum',
+            )
+                
+        self.env = env_fn(self.task_name)
+
+
+        self.fps = fps
+        self.crf = crf
+        self.n_obs_steps = n_obs_steps
+        self.n_action_steps = n_action_steps
+        self.max_steps = max_steps
+        self.tqdm_interval_sec = tqdm_interval_sec
+
+        self.logger_util_test = logger_util.LargestKRecorder(K=3)
+        self.logger_util_test10 = logger_util.LargestKRecorder(K=5)
+
+    def run(self, policy: BasePolicy, save_video=None, save_rollout_data=None):
+        device = policy.device
+
+        if save_video is None:
+            save_video = self.save_rollout_video
+        if save_rollout_data is None:
+            save_rollout_data = self.save_rollout_data
+        artifact_eval_dir = self._make_rollout_eval_dir() \
+            if save_video or save_rollout_data or self.save_timing else None
+
+        all_traj_rewards = []
+        all_success_rates = []
+        all_step_timings = []
+        evaluation_timing_summary = None
+        env = self.env
+        base_env = self._unwrap_env(env)
+        if self.eval_seed is not None:
+            cprint(
+                "RLBench evaluation episode seeds: "
+                f"{self.eval_seed}..{self.eval_seed + self.eval_episodes - 1}",
+                'cyan',
+            )
+
+        eval_progress = tqdm.tqdm(
+            total=self.eval_episodes,
+            desc=f"Eval in RLBench {self.task_name} Pointcloud Env",
+            leave=False,
+            mininterval=self.tqdm_interval_sec,
+        )
+        for episode_idx in range(self.eval_episodes):
+            episode_seed = None
+            if self.eval_seed is not None:
+                episode_seed = self.eval_seed + episode_idx
+
+            # start rollout
+            obs = env.reset(seed=episode_seed)
+            policy.reset()
+
+            done = False
+            traj_reward = 0
+            is_success = False
+            policy_step_idx = 0
+            episode_step_timings = []
+            while not done:
+                observation_timings = (
+                    base_env.pop_timing_records()
+                    if self.save_timing
+                    and hasattr(base_env, 'pop_timing_records')
+                    else []
+                )
+                observation_totals = {
+                    key: float(sum(record.get(key, 0.0)
+                                   for record in observation_timings))
+                    for key in (
+                        'rgb_preprocessing_s',
+                        'depth_estimation_s',
+                        'point_cloud_reconstruction_s',
+                        'point_cloud_preprocessing_s',
+                    )
+                }
+
+                policy_input_start = time.time()
+                np_obs_dict = dict(obs)
+                obs_dict = dict_apply(np_obs_dict,
+                                      lambda x: torch.from_numpy(x).to(
+                                          device=device))
+
+                with torch.no_grad():
+                    obs_dict_input = {}
+                    obs_dict_input['point_cloud'] = obs_dict['point_cloud'].unsqueeze(0)
+                    obs_dict_input['agent_pos'] = obs_dict['agent_pos'].unsqueeze(0)
+                policy_input_preprocessing_s = (
+                    time.time() - policy_input_start
+                )
+
+                policy_inference_start = time.time()
+                with torch.no_grad():
+                    action_dict = policy.predict_action(obs_dict_input)
+                policy_inference_s = time.time() - policy_inference_start
+
+                policy_output_start = time.time()
+                np_action_dict = dict_apply(action_dict,
+                                            lambda x: x.detach().to('cpu').numpy())
+                action = np_action_dict['action'].squeeze(0)
+                policy_output_postprocessing_s = (
+                    time.time() - policy_output_start
+                )
+
+                if self.save_timing:
+                    point_cloud_preprocessing_s = observation_totals[
+                        'point_cloud_preprocessing_s'
+                    ]
+                    data_preprocessing_s = (
+                        point_cloud_preprocessing_s
+                        + policy_input_preprocessing_s
+                    )
+                    total_pipeline_s = (
+                        observation_totals['rgb_preprocessing_s']
+                        + observation_totals['depth_estimation_s']
+                        + observation_totals['point_cloud_reconstruction_s']
+                        + data_preprocessing_s
+                        + policy_inference_s
+                        + policy_output_postprocessing_s
+                    )
+                    timing_record = {
+                        'episode_index': episode_idx,
+                        'episode_seed': episode_seed,
+                        'policy_step_index': policy_step_idx,
+                        'rollout_success': None,
+                        'trajectory_reward': None,
+                        'observation_count': len(observation_timings),
+                        'rgb_preprocessing_ms': 1000.0 * observation_totals[
+                            'rgb_preprocessing_s'
+                        ],
+                        'depth_estimation_ms': 1000.0 * observation_totals[
+                            'depth_estimation_s'
+                        ],
+                        'point_cloud_reconstruction_ms': 1000.0 * (
+                            observation_totals['point_cloud_reconstruction_s']
+                        ),
+                        'point_cloud_preprocessing_ms': 1000.0 * (
+                            point_cloud_preprocessing_s
+                        ),
+                        'policy_input_preprocessing_ms': 1000.0 * (
+                            policy_input_preprocessing_s
+                        ),
+                        'data_preprocessing_ms': 1000.0 * data_preprocessing_s,
+                        'policy_inference_ms': 1000.0 * policy_inference_s,
+                        'policy_output_postprocessing_ms': 1000.0 * (
+                            policy_output_postprocessing_s
+                        ),
+                        'total_pipeline_ms': 1000.0 * total_pipeline_s,
+                    }
+                    episode_step_timings.append(timing_record)
+                    all_step_timings.append(timing_record)
+
+                obs, reward, done, info = env.step(action)
+
+
+                traj_reward += reward
+                done = np.all(done)
+                is_success = is_success or max(info['success'])
+                policy_step_idx += 1
+
+            all_success_rates.append(is_success)
+            all_traj_rewards.append(traj_reward)
+            if self.save_timing:
+                for timing_record in episode_step_timings:
+                    timing_record['rollout_success'] = bool(is_success)
+                    timing_record['trajectory_reward'] = float(traj_reward)
+                timing_output_dir = os.path.join(
+                    artifact_eval_dir,
+                    self.timing_dir,
+                )
+                evaluation_timing_summary = write_evaluation_timing(
+                    timing_output_dir,
+                    all_step_timings,
+                    metadata={
+                        'task_name': self.task_name,
+                        'depth_estimator': self.depth_est_name,
+                        'configured_rollout_count': self.eval_episodes,
+                        'timing_clock': 'time.time',
+                        'cuda_synchronized': False,
+                        'n_obs_steps': self.n_obs_steps,
+                        'n_action_steps': self.n_action_steps,
+                    },
+                )
+            if save_video or save_rollout_data:
+                outcome = 'success' if is_success else 'failure'
+                artifact_name = f'rollout_{episode_idx:03d}_{outcome}'
+
+            if save_video:
+                try:
+                    video_path = os.path.join(
+                        artifact_eval_dir,
+                        'live_videos',
+                        f'{artifact_name}.mp4',
+                    )
+                    env.env.save_video(video_path, fps=self.fps)
+                except Exception as exc:
+                    cprint(
+                        f"Failed to save rollout {episode_idx} video: {exc}",
+                        'red',
+                    )
+            if save_rollout_data:
+                try:
+                    state_path = os.path.join(
+                        artifact_eval_dir,
+                        'live_states',
+                        f'{artifact_name}.npz',
+                    )
+                    env.env.save_rollout_data(
+                        state_path,
+                        fps=self.fps,
+                    )
+                except Exception as exc:
+                    cprint(
+                        f"Failed to save rollout {episode_idx} data: {exc}",
+                        'red',
+                    )
+            current_success_rate = float(np.mean(all_success_rates))
+            eval_progress.set_postfix(
+                success_rate=f"{current_success_rate:.1%}",
+                episode_seed=episode_seed,
+                refresh=False,
+            )
+            eval_progress.update(1)
+
+        eval_progress.close()
+            
+
+        log_data = dict()
+
+        log_data['mean_traj_rewards'] = np.mean(all_traj_rewards)
+        # log_data['mean_success_rates'] = np.mean(all_success_rates)
+
+        log_data['test_mean_score'] = np.mean(all_success_rates)
+        if self.eval_seed is not None:
+            log_data['eval_seed'] = self.eval_seed
+        
+        cprint(f"test_mean_score: {np.mean(all_success_rates)}", 'green')
+
+        self.logger_util_test.record(np.mean(all_success_rates))
+        self.logger_util_test10.record(np.mean(all_success_rates))
+        log_data['SR_test_L3'] = self.logger_util_test.average_of_largest_K()
+        log_data['SR_test_L5'] = self.logger_util_test10.average_of_largest_K()
+
+        if evaluation_timing_summary is not None:
+            for stage in STAGE_FIELDS:
+                stage_name = stage.removesuffix('_ms')
+                log_data[f'timing_step_mean_{stage_name}_ms'] = (
+                    evaluation_timing_summary['step_weighted_statistics'][
+                        stage
+                    ]['mean_ms']
+                )
+                log_data[f'timing_rollout_mean_{stage_name}_ms'] = (
+                    evaluation_timing_summary['rollout_weighted_statistics'][
+                        stage
+                    ]['mean_ms']
+                )
+            summary_path = evaluation_timing_summary['files'][
+                'evaluation_timing_summary_json'
+            ]
+            cprint(f"Saved evaluation timings to {summary_path}", 'cyan')
+        
+
+        _ = env.reset()
+
+        return log_data
+
+    @staticmethod
+    def _unwrap_env(env):
+        while not hasattr(env, 'pop_timing_records') and hasattr(env, 'env'):
+            env = env.env
+        return env
+
+    def _make_rollout_eval_dir(self):
+        """Create a new directory without overwriting earlier evaluations."""
+        root = os.path.join(self.output_dir, self.rollout_dir)
+        os.makedirs(root, exist_ok=True)
+        eval_idx = 0
+        while True:
+            eval_dir = os.path.join(root, f'eval_{eval_idx:04d}')
+            try:
+                os.mkdir(eval_dir)
+                os.mkdir(os.path.join(eval_dir, 'live_videos'))
+                os.mkdir(os.path.join(eval_dir, 'live_states'))
+                cprint(f"Saving rollout artifacts to {eval_dir}", 'cyan')
+                return eval_dir
+            except FileExistsError:
+                eval_idx += 1
