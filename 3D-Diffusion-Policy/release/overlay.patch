+    def save_video(self, file_path, fps=10):
+        """Encode the frames from the current episode as an MP4 file."""
+        if not self.frames:
+            raise RuntimeError("No frames recorded. Call reset() before save_video().")
+        if fps <= 0:
+            raise ValueError(f"fps must be positive, got {fps!r}")
+
+        first_frame = self.frames[0]
+        if first_frame.ndim != 3 or first_frame.shape[2] != 3:
+            raise ValueError(
+                f"Expected RGB frames with shape (H, W, 3), got {first_frame.shape}"
+            )
+
+        height, width = first_frame.shape[:2]
+        parent_dir = os.path.dirname(os.path.abspath(file_path))
+        os.makedirs(parent_dir, exist_ok=True)
+
+        writer = cv2.VideoWriter(
+            file_path,
+            cv2.VideoWriter_fourcc(*'mp4v'),
+            fps,
+            (width, height),
+        )
+        if not writer.isOpened():
+            raise RuntimeError(f"Could not open video writer for {file_path!r}")
+
+        try:
+            for frame_idx, frame in enumerate(self.frames):
+                if frame.dtype != np.uint8 or frame.shape != first_frame.shape:
+                    raise ValueError(
+                        f"Frame {frame_idx} has dtype/shape {frame.dtype}/{frame.shape}; "
+                        f"expected uint8/{first_frame.shape}"
+                    )
+                writer.write(cv2.cvtColor(frame, cv2.COLOR_RGB2BGR))
+        finally:
+            writer.release()
+
+    def save_rollout_data(self, file_path, fps=10):
+        """Save synchronized non-RGB rollout observations for offline analysis."""
