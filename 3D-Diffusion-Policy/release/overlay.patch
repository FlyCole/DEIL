+def _build_timing_summaries(step_records):
+    grouped = defaultdict(list)
+    for record in step_records:
+        grouped[int(record['episode_index'])].append(record)
+
+    rollout_rows = []
+    for episode_index, records in sorted(grouped.items()):
+        first = records[0]
+        row = {
+            'episode_index': episode_index,
+            'episode_seed': first.get('episode_seed'),
+            'rollout_success': first.get('rollout_success'),
+            'trajectory_reward': first.get('trajectory_reward'),
+            'policy_step_count': len(records),
+            'observation_count': int(sum(
+                int(record.get('observation_count', 0))
+                for record in records
+            )),
+        }
+        for stage in STAGE_FIELDS:
+            values = np.asarray(
+                [float(record[stage]) for record in records],
+                dtype=np.float64,
+            )
+            stage_name = stage.removesuffix('_ms')
+            row[f'{stage_name}_mean_ms'] = float(values.mean())
+            row[f'{stage_name}_total_ms'] = float(values.sum())
+        rollout_rows.append(row)
+
+    step_weighted = {
+        stage: _timing_distribution([
+            float(record[stage]) for record in step_records
+        ])
+        for stage in STAGE_FIELDS
+    }
+    rollout_weighted = {}
+    for stage in STAGE_FIELDS:
+        mean_field = f"{stage.removesuffix('_ms')}_mean_ms"
+        rollout_weighted[stage] = _timing_distribution([
+            float(row[mean_field]) for row in rollout_rows
+        ])
+    return rollout_rows, step_weighted, rollout_weighted
